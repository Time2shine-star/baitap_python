import random
def choose_word():
    words = ["apple", "banana", "cherry", "orange", "pear", "grape", "kiwi"]
    return random.choice(words)
def display_word(word, guessed_letters):
    display = ""
    for letters in word:
        if letters in guessed_letters:
            display += letters + " "
        else :
            display += "_"

    return display.strip()
def hangman():
    word = choose_word()
    guessed_letters = []
    attempts = 6
    print("Welcome to Hangman!")
    print("Try to guess the word.")
    while attempts > 0:
        current_display = display_word(word, guessed_letters)
        print("\nWord:", current_display)
        
        # 2. SỬA LỖI: Dùng biến 'guess' để tránh ghi đè làm mất từ bí mật 'word'
        guess = input("Nhap chu cai: ").lower()
        
        # Kiểm tra xem người dùng đã đoán chữ này chưa
        if guess in guessed_letters:
            print("Bạn đã đoán chữ này rồi! Thử chữ khác nhé.")
            continue
            
        # 3. SỬA LỖI: Truyền biến 'guess' vào hàm append
        guessed_letters.append(guess)

        # 4. LOGIC MỚI: Kiểm tra xem chữ vừa đoán có nằm trong từ không
        if guess not in word:
            attempts -= 1  # Trừ đi 1 mạng nếu đoán sai
            print(f"Sai rồi! Bạn còn lại {attempts} lượt đoán.")
        else:
            print("Chính xác!")

        # 5. LOGIC MỚI: Kiểm tra điều kiện thắng (nếu không còn dấu "_" nào)
        if "_" not in display_word(word, guessed_letters):
            print(f"\nChúc mừng! Bạn đã thắng! Từ đúng là: {word}")
            break

        if attempts == 0:
            print("\nSorry, you've run out of attempts. The word was:", word)
